# Copy to .env. Used by `docker compose` and by local development.

# Required: signs login tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Docker: the database password (Postgres isn't reachable from outside)
POSTGRES_PASSWORD=change-me

# Docker: the port the app is served on, and its address as people open it
PORT=8080
APP_URL=http://localhost:8080

# Local development only (bun run dev): your Postgres
DATABASE_URL=postgres://user:password@localhost:5432/llm_thingy
